{
  "components": {
    "ClientUpdate": {
      "description": "Write shape for POST /panel/api/clients/update/{email}. The endpoint replaces the whole row, so send every field you want to keep.",
      "allOf": [
        { "$ref": "#/components/schemas/Client" },
        {
          "type": "object",
          "properties": {
            "limitHwid": {
              "description": "Maximum registered devices, 0 for unlimited.",
              "type": "integer"
            }
          }
        }
      ]
    },
    "ClientDetail": {
      "description": "Read shape for GET /panel/api/clients/get/{email}.",
      "type": "object",
      "properties": {
        "client": { "$ref": "#/components/schemas/ClientRecord" },
        "inboundIds": { "type": "array", "items": { "type": "integer" } },
        "externalLinks": { "type": "array", "items": { "type": "object" } },
        "usedTraffic": { "type": "integer", "format": "int64" },
        "tunnelAllowedIPs": { "type": "object" }
      },
      "required": ["client", "inboundIds"]
    }
  },
  "responses": {
    "/panel/api/clients/get/{email}|get": "#/components/schemas/ClientDetail"
  },
  "requestBodies": {
    "/panel/api/clients/update/{email}|post": "#/components/schemas/ClientUpdate"
  }
}
